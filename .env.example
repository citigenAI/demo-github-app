# === Environment ===
NODE_ENV=development

# === Database (Supabase) ===
# Environment isolation uses PostgreSQL SCHEMAS in the default `postgres` database,
# because Supabase's pooler routes only to the default `postgres` database.
# Switch ?schema=swara_dev to ?schema=swara_test or ?schema=swara_prd per environment.
# Substitute <PASSWORD> with the database password set when creating the Supabase project
# (URL-encode special characters: @ -> %40, # -> %23, etc).
#
# DATABASE_URL: transaction pooler (PgBouncer, port 6543) — used by the app at runtime.
DATABASE_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&schema=swara_dev
#
# DIRECT_URL: session pooler (port 5432) — used by `prisma migrate` (supports prepared statements).
DIRECT_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=swara_dev

# === Redis / BullMQ (local Docker in dev, Upstash in prod) ===
REDIS_URL=redis://localhost:6379

# === App ===
NEXT_PUBLIC_APP_URL=http://localhost:3000

# === Auth (Story 2) ===
# Generate NEXTAUTH_SECRET with: openssl rand -base64 48
NEXTAUTH_SECRET=<generated-secret-min-32-chars>
NEXTAUTH_URL=http://localhost:3000
# Comma-separated email domains that receive the ADMIN role (enforced in Story 7)
ADMIN_EMAIL_DOMAINS=yourdomain.com

# === Email (Story 2) ===
# Dev: Mailpit SMTP (docker compose up -d; UI at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
# Prod: Resend (required in production, optional in dev)
RESEND_API_KEY=re_...
RESEND_FROM_ADDRESS=noreply@yourdomain.com

# === Reserved for later stories — left blank until their owning story ===
# Stripe: STRIPE_SECRET_KEY, NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY, STRIPE_WEBHOOK_SECRET
# AI: ANTHROPIC_API_KEY, OPENAI_API_KEY, AI_MOCK_MODE
# Storage: S3_ENDPOINT, S3_BUCKET, S3_REGION, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, S3_FORCE_PATH_STYLE
# Editor: EDITOR_TOKEN_SECRET
# Share: NEXT_PUBLIC_SHARE_DOMAIN
