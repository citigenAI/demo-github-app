# === Environment ===
NODE_ENV=development

# === Database (Supabase) ===
# Environment isolation uses PostgreSQL SCHEMAS in the default `postgres` database,
# because Supabase's pooler does not route to non-default databases.
# Switch ?schema=swara_dev to ?schema=swara_test or ?schema=swara_prd per environment.
# Substitute <PASSWORD> with the database password set when creating the Supabase project
# (URL-encode special characters: @ -> %40, # -> %23, etc).
#
# DATABASE_URL: transaction pooler (PgBouncer, port 6543) — used by the app at runtime.
DATABASE_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&schema=swara_dev
#
# DIRECT_URL: session pooler (port 5432) — used by `prisma migrate`.
DIRECT_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=swara_dev

# === Redis / BullMQ (local Docker in dev, Upstash in prod) ===
REDIS_URL=redis://localhost:6379

# === App ===
NEXT_PUBLIC_APP_URL=http://localhost:3000

# === Reserved for later stories — left blank in Story 1 ===
# Auth: NEXTAUTH_SECRET, NEXTAUTH_URL, ADMIN_EMAIL_DOMAINS
# Stripe: STRIPE_SECRET_KEY, STRIPE_PUBLISHABLE_KEY, STRIPE_WEBHOOK_SECRET
# AI: ANTHROPIC_API_KEY, OPENAI_API_KEY, SONNET_MODEL, OPUS_MODEL, WHISPER_MODEL, AI_MOCK_MODE
# Storage: S3_ENDPOINT, S3_BUCKET, S3_REGION, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, S3_FORCE_PATH_STYLE
# Email: SMTP_HOST, SMTP_PORT, RESEND_API_KEY, RESEND_FROM_ADDRESS
# Editor: EDITOR_TOKEN_SECRET
# Share: NEXT_PUBLIC_SHARE_DOMAIN
